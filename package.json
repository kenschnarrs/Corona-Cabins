{
  "name": "corona-cabins",
  "version": "1.0.0",
  "description": "A website for the Corona family's cabins in rural Mexico.",
  "scripts": {
    "dev": "next",
    "build": "prisma generate && next build",
    "start": "next start",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test": "node scripts/check-i18n.mjs && node scripts/check-rich-text.mjs && node scripts/check-booking.mjs"
  },
  "keywords": [
    "cabins",
    "cabañas",
    "corona",
    "mexico"
  ],
  "author": "Ken Schnarrs",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.2.55",
    "@vercel/blob": "^0.23.2",
    "next": "^14.1.0",
    "next-auth": "^4.24.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sanitize-html": "^2.17.7",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.3"
  },
  "engines": {
    "node": "22.x"
  }
}
