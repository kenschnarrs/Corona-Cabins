{
  "name": "corona-cabins",
  "version": "1.0.0",
  "description": "A website for the Corona family's cabins in rural Mexico.",
  "scripts": {
    "dev": "next",
    "build": "prisma generate && next build",
    "start": "next start",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "keywords": [
    "cabins",
    "cabañas",
    "corona",
    "mexico"
  ],
  "author": "Ken Schnarrs",
  "license": "MIT",
  "dependencies": {
    "@nextui-org/card": "^2.0.28",
    "@nextui-org/navbar": "^2.0.30",
    "@nextui-org/react": "^2.3.6",
    "@nextui-org/system": "^2.1.2",
    "@nextui-org/theme": "^2.2.3",
    "@prisma/client": "^5.9.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.2.55",
    "@vercel/blob": "^0.23.2",
    "framer-motion": "^11.0.3",
    "next": "^14.1.0",
    "next-auth": "^4.24.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.3"
  },
  "engines": {
    "node": "22.x"
  }
}
