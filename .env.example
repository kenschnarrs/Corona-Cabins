# Copy to .env for local development. In production/preview, set these as
# protected Vercel environment variables. Never commit real values.

# Database (Neon Postgres; provided by the Vercel Neon integration)
POSTGRES_PRISMA_URL="postgresql://user:password@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/db"

# Google OAuth sign-in (admin access)
GOOGLE_ID=""
GOOGLE_SECRET=""

# NextAuth - stable random secret (e.g. `openssl rand -base64 32`).
# Required in production. Sessions stay valid across redeploys.
NEXTAUTH_SECRET=""
# Canonical site URL (Vercel sets VERCEL_URL automatically; set explicitly for production)
NEXTAUTH_URL="http://localhost:3000"

# Admin allowlist - comma-separated emails allowed to sign in and use admin
# pages. Enforced server-side. Example:
# ADMIN_EMAIL_ALLOWLIST="admin1@example.com,admin2@example.com"
ADMIN_EMAIL_ALLOWLIST=""
