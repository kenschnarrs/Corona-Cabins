// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum BookingStatus {
  PENDING
  SCHEDULED
  CUSTOMER_CANCELLED
  MANAGEMENT_CANCELLED
  ACTIVE
  COMPLETED
}

enum PictureType {
  Primary
  LivingRoom
  Bedroom1
  Bedroom2
  Bedroom3
  Kitchen
  Bathroom
  DiningRoom
  Balcony
  Outside
  Other
}

model Inquiry {
  id             String          @default(cuid()) @id
  status         BookingStatus   @default(PENDING)
  customer_name  String
  customer_email String
  customer_phone String
  // Guest's site language at booking time; drives single-language emails.
  locale         String          @default("es")
  // Short sequential number guests quote, e.g. "#1042". The cuid stays the
  // internal key; a Postgres sequence keeps concurrent submits safe.
  request_number Int             @unique @default(dbgenerated("nextval('inquiry_request_number_seq')"))
  notes          String          @db.Text
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  cabins         CabinInquiry[]
  customer       User?           @relation(fields: [customerId], references: [id])
  customerId     String?

  @@index([status, created_at])
}

model CabinInquiry {
  cabin     Cabin @relation(fields: [cabinId], references: [id])
  cabinId   String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id])
  inquiryId String

  startDate DateTime
  endDate   DateTime
  header    String @db.Text
  body      String @db.Text

  @@id([cabinId, inquiryId])
  @@index([cabinId, startDate, endDate])
}

model Cabin {
  id                String     @default(cuid()) @id
  name              String
  num_bathrooms     Int
  num_bedrooms      Int
  num_beds          Int
  num_floors        Int
  square_feet       Int
  price_per_night   Decimal
  description       String @db.Text
  description_es    String @db.Text
  description_en    String @db.Text
  has_kitchen       Boolean    @default(false)
  has_wood_stove    Boolean    @default(false)
  has_terrace       Boolean    @default(false)
  inquiries         CabinInquiry[]
  reservations      CabinReservation[]
  images            CabinImage[]
}

model CabinImage {
  id                String          @default(cuid()) @id
  url               String
  type              PictureType              
  cabin             Cabin           @relation(fields: [cabinId], references: [id])
  cabinId           String
  sort_order        Int             @default(0)
  blob_pathname     String?         @unique

  @@index([cabinId, sort_order])
}

model CabinReservation {
  cabin     Cabin @relation(fields: [cabinId], references: [id])
  cabinId   String

  reservation   Reservation @relation(fields: [reservationId], references: [id])
  reservationId String

  startDate DateTime
  endDate   DateTime

  @@id([cabinId, reservationId])
}

model Reservation {
  id         String     @default(cuid()) @id
  cabins     CabinReservation[]
  customer   User?      @relation(fields: [customerId], references: [id]) 
  customerId String?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique@map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields:[userId], references:[id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?@unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  inquiries     Inquiry[]
  reservations  Reservation[]
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CalendarConnection {
  id                   String    @id @default("primary")
  connectedEmail       String    @default("")
  calendarId           String    @default("")
  calendarName         String    @default("")
  refreshToken         String    @db.Text
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model BookingCalendarEvent {
  id            String   @id @default(cuid())
  inquiryId     String
  cabinId       String
  googleEventId String
  calendarId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([inquiryId, cabinId])
}
